msgid ""
"Legend: <em>number of requests</em> (<em>number of characters used</em>)"
msgstr ""
"Legende: <em>Anzahl der Anfragen</em> (<em>Anzahl der verwendeten Zeichen</"
"em>)"

msgid "period"
msgstr "Zeitraum"

msgid "total"
msgstr "insgesamt"


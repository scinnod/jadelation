msgstr "DeepL Übersetzung"

#, python-format
msgid ""
"The text exceeds the maximum allowed length of %(limit)s characters "
"(currently %(length)s characters)."
msgstr ""
"Der Text überschreitet die maximal zulässige Länge von %(limit)s Zeichen "
"(aktuell %(length)s Zeichen)."


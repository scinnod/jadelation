# Generated from hgignore - Ignore files for Git
# Follows best practices: explicit .gitignore tracking, .gitkeep for dirs, consistent patterns

# ========================
# Python
# ========================
*.pyc
*.pyo
*.pyd
*$py.class
__pycache__/
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# ========================
# Django
# ========================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
static/
staticfiles/

# ========================
# Environment Variables
# ========================
.env
.env.local
.env.*.local
*.env~
# Actual env files with secrets (keep only .sample and .example files)
env/deepl.env
env/itsm.env
!env/*.sample
!env/*.example

# ========================
# IDEs
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
\#*\#
.DS_Store

# ========================
# Docker
# ========================
docker-compose.override.yml

# ========================
# Testing
# ========================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ========================
# Database dumps
# ========================
*.sql.gz
*.dump

# ========================
# Secrets
# ========================
/secrets/

# ========================
# User-specific files
# ========================
# Top-level user_files/ is completely excluded (organization-specific data)
# apps/itsm/user_files/ contains dummy data and is tracked in the repository
user_files/

# ========================
# Overrides (organization-specific customizations)
# ========================
# The overrides/ directory structure (.gitkeep files and README) is tracked,
# but actual content files (logos, about texts, etc.) are not.
overrides/**
!overrides/README.md
!overrides/**/.gitkeep

# ========================
# Backups
# ========================
*.bak
*~
\#*\#

# ========================
# LaTeX temporary files
# ========================
*.aux
*.log
*.out
*.toc
*.pdf

# ========================
# Translations
# ========================
*.mo
*.pot

# ========================
# Virtual Environments
# ========================
venv/
env/
ENV/
.venv

# ========================
# macOS
# ========================
.DS_Store
.AppleDouble
.LSOverride

# ========================
# Windows
# ========================
Thumbs.db
ehthumbs.db
Desktop.ini

# ========================
# Postgres dumps
# ========================
/postgres/dumps/*.sql
!/postgres/dumps/.gitkeep

# ========================
# Nginx certificates
# ========================
# Example: if you have certs in nginx/certs/
# nginx/certs/
# or
# *.crt
# *.key
# *.pem

# ========================
# Explicitly allow .gitignore to be tracked
# ========================
!.gitignore

# ========================
# Optional: Ignore all other hidden files except .gitignore and .github
# ========================
.*
!.gitignore
!.github/

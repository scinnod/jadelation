# ==============================================================================
# DeepL Translation Frontend - Environment Configuration
# ==============================================================================
#
# This file contains configuration settings for the DeepL translation service.
# Copy this file to 'deepl.env' and adjust the values for your installation.
#
# IMPORTANT: Never commit the actual deepl.env file with real credentials to
# version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# DeepL API Configuration
# ------------------------------------------------------------------------------

# Your DeepL API authentication key (required)
# Get your key from: https://www.deepl.com/pro-api
DEEPL_AUTHKEY=your-deepl-api-key-here

# ------------------------------------------------------------------------------
# Django Security Settings
# ------------------------------------------------------------------------------

# Django secret key (AUTOMATICALLY GENERATED - DO NOT SET MANUALLY)
# The secret key is automatically generated on first run and stored in a file
# at the path specified by SECRET_KEY_FILE (default: /app/secrets/django_secret_key)
# This file is persisted in a Docker volume.
#
# For local development outside Docker, you can generate a key with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# and set it here as DJANGO_SECRET_KEY=your-generated-key
#
# DJANGO_SECRET_KEY is set automatically by entrypoint.sh - do not set it here

# Debug mode (set to False in production)
DJANGO_DEBUG=False

# Allowed hosts (comma-separated list of domains/IPs allowed to access the service)
# Example: DJANGO_ALLOWED_HOSTS=deepl.example.com,192.168.1.100
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins (comma-separated, required for HTTPS deployments)
# Include the full URL with protocol (https://), no trailing slash
# Example: CSRF_TRUSTED_ORIGINS=https://translation.jade.local,https://deepl.example.com
CSRF_TRUSTED_ORIGINS=https://translation.jade.local

# ------------------------------------------------------------------------------
# Application Branding
# ------------------------------------------------------------------------------

# Application title displayed in the browser tab
# Supports multiple languages: use _en, _de suffixes for language-specific versions
APP_TITLE_EN=DeepL Translation Frontend
APP_TITLE_DE=DeepL Übersetzungs-Frontend

# Organization or institution name (displayed in footer)
# Leave empty to hide organization name
# Supports multiple languages: use _en, _de suffixes for language-specific versions
ORGANIZATION_NAME_EN=Your Organization Name
ORGANIZATION_NAME_DE=Ihr Organisationsname

# Footer text (displayed below organization name)
# Use {year} as placeholder for current year
# Leave empty to use default text
FOOTER_TEXT={year}+ Translation Service

# Logo filename (must be placed in staticfiles/logo/ directory)
# Supported formats: .jpg, .png, .svg
# Leave empty to disable logo
# Example: LOGO_FILENAME=logo.png
LOGO_FILENAME=

# Logo maximum width in pixels
# Default: 250
LOGO_MAX_WIDTH=250

# ------------------------------------------------------------------------------
# Corporate Identity - Colors (hex codes WITHOUT the # symbol)
# ------------------------------------------------------------------------------

# Primary brand color (used for buttons, links, accents)
# Example: PRIMARY_COLOR=0d6efd (Bootstrap blue)
PRIMARY_COLOR=0d6efd

# Secondary brand color (used for secondary buttons and accents)
# Example: SECONDARY_COLOR=6610f2 (Bootstrap indigo)
SECONDARY_COLOR=6610f2

# ------------------------------------------------------------------------------
# Logging Configuration (Optional)
# ------------------------------------------------------------------------------

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
# LOG_FILE=/var/log/deepl-frontend/app.log

# ------------------------------------------------------------------------------
# Translation Settings
# ------------------------------------------------------------------------------

# Number of characters used for auto-detection
TRANSLATION_DETECTION_LEN=30

# Statistics retention periods
STATISTICS_DAYS=31
STATISTICS_MONTHS=24
STATISTICS_YEARS=5

# ------------------------------------------------------------------------------
# Time Zone and Language
# ------------------------------------------------------------------------------

# Time zone for the application
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=Europe/Berlin

# Default language code
LANGUAGE_CODE=en-us
